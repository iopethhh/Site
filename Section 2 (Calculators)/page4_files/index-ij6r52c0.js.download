I,v5uzEY:dI,v7ozpI:gI,v9Ghb3:mI,v9a5yf:AI,vCnJ50:pI,vHL0ZI:hI,vIsUDR:xI,vJLrmn:jI,vLfaqU:bI,vNDjVH:yI,vV9LzZ:vI,vbPOGC:wI,vdg7XO:fI,vjj7Op:kI,vmELHB:_I,vrf0RX:MI,vsENvj:TI,vtWDEK:CI,"w2+x0K":"Halo Bow T10",w3RgRM:BI,w66ldX:SI,wIHLga:II,"wNRU/g":"Witch (Tuesday - partly, Wednesday)",waGgkn:RI,wpXftU:DI,"wrW+dv":"Characters parameters",wtJB97:PI,wuAhKM:EI,wz06gZ:QI,xFvNzW:qI,xKt1IP:FI,xMLN6s:NI,xPQrud:GI,xQxUlz:zI,xSsYYS:KI,xTTDVC:VI,xXW9Ul:LI,xssHQW:HI,xxMGAl:WI,"y/q/GT":"Subscribe for 990₽",y0eRj6:UI,yBgzQm:YI,yChBli:OI,yJspRe:JI,"yP/ZfF":"New levels of Witch Gems",yPO12C:ZI,ySU803:XI,ygA5NF:$I,yoRozG:e4,yvUY0m:s4,yvxj8J:t4,ywUDDN:a4,yzAsVm:o4,z32Qwr:n4,z9LlQe:r4,"zA5e+J":"After purchase, your subscription will be valid until {until}",zDebBc:l4,zNTWmi:c4,zO0iCe:i4,zXkVd5:u4,"zier1/":"Delete","zpV1O+":"Points for one member",zyJ4QC:d4,zzS06F:g4},A4="Как пользоваться",p4="Дерево",h4="Книга опыта гоблинов 3-го ранга",x4="Нажимая кнопку Загрузить, вы соглашаетесь с тем, что администрация сайта не несет ответственность за ваш аккаунт и за ваших персонажей.",j4="По скорости{index}",b4="Осталось:",y4="Подписка на 1 месяц (30 дней)",v4="Казарма и таланты (понедельник)",w4="Таблицы и гайды",f4="<b>Внесите данные</b> — вручную или нажатием одной кнопки «Загрузить данные из игры» (работает бесплатно)",k4="Ресурсы",_4="Документы",M4="По увеличению мощи{index}",T4="Волшебная книга T1",C4="Очки Огненной Экспедиции",B4="Новый ранг!",S4="Карт в наличии:",I4="Пароль был успешно сброшен.",R4="По сокращению ОД{index}",D4="T6 Меч",P4="Авторизация",E4="Нет аккаунта? Зарегистрироваться",Q4="Покупка подписки на +{days} дней ({sum} ₽)",q4="<Text>Новая методика расчета будет прокачивать 1 большой атрибут (с коронами) через каждые 8 маленьких атрибутов (только книги).</Text> <Text>Старая методика расчета (если эту опцию выключить) будет сначала прокачивать все маленькие атрибуты, и только потом большие.</Text>",F4="2 звезды",N4="Калькулятор казармы",G4="Желаемый уровень замка",z4="Хребет",K4="Принять соглашение",V4="Подписаться",L4="Рубин T10",H4="Всего очков за <Red>босс</Red> волны:",W4="T10 Посох",U4="Рубин T5",Y4="Раздел для настройки ваших героев, а так же распределении карт самовыбора. Если вы хотите использовать продвинутый режим расчета героев, то данный раздел будет обязательным к заполнению. К сожалению, из-за большого количества героев, а так же не очень показательного интерфейса героев в игре, заполнение данного раздела может занять продолжительное время. Я постарался упростить заполнение на столько, на сколько возможно.",O4="Рубин T3",J4="Чертеж кузницы Нимб T10",Z4="трлн.",X4="Самый главный раздел, содержащий в себе подразделы, а именно - отдельные калькуляторы. Рекомендую ознакомиться с каждым из них в отдельности. Некоторые из них по итогам расчетов готовы предоставить вам дополнительную вспомогательную информацию. Например, калькулятор дракона подскажет, сколько коробок открывать для получения той или иной руны.",$4="Таверна (вербовка по показателям)",eR="Осколок галлереи",sR="Сердце нефритового дракона T1",tR="Регенерация",aR="T6 Лук",oR="Максимальные значения в каждом ранге:",nR="Книга опыта ледяных колдуний 3-го ранга",rR="Имперский Мечник T5",lR="Волшебная пыль T11",cR="T9 Кинжал",iR="Политика использования файлов cookie и аналитических технологий",uR="Кузнец",dR="Учитывать уровень замка при прокачке дракона",gR="Информация по мощи волн для данного уровня отсутствует.",mR="Скорость войск",AR="Чертеж кузницы Грома T9",pR="Очков за 1 человека (простые волны):",hR="Расчеты доступны при наличии активной подписки",xR="Противодействие монстрам",jR="T4 Меч",bR="Рога лазурного дракона T2",yR="19-я волна",vR="Внимание! Не забудьте выставить корректные <link>серверные настройки</link> для вашего профиля, который вы добавили из игры",wR="Уровень: {oldLevel} {arrow} {newLevel}",fR="Надзиратель",kR="Пресеты",_R="Карты героев SR-ранга",MR="Потраченные ресурсы",TR="Замок",CR="Рога дракона Ледяного Мороза T13",BR="Лук Победы T12",SR="Кузнечный молот",IR="Выберите профиль персонажа, для которого нужно загрузить данные из игры",RR="Количество очков, которые необходимо набрать, чтобы открыть уровень в событии Вторжение злых духов",DR="Для загрузки данных следуйте трем простым шагам.",PR="Инвентарь",ER="Чертеж: доспехи Пламени T11",QR="Казарма + таланты",qR="Калькуляторы",FR="Потрачено самовыбора: {value}",NR="Кнопка {button} автоматически распределит карты самовыбора так, чтобы прокачать как можно больше звезд вашим героям. Кнопка остановится, когда больше нельзя будет поднять никому новую звезду с оставшимся количеством карт самовыбора.",GR="Я решил разработать собственную версию калькулятора, и сделать ее веб-версией по нескольким причинам:",zR="По стихии",KR="Используем коробки ресурсов замка?",VR="Сердце Пламенного Дракона T11",LR="Количество игроков в альянсе",HR="Загрузка данных приведет к очищению всех данных, введеных вручную ранее, в калькуляторе!",WR="Конвертация коробок в руны",UR="Загрузить данные из игры",YR="Волшебная книга T12",OR="T5 Меч",JR="Рубин T6",ZR="Мощь войск",XR="T10 Лук",$R="Книга опыта огненных магов 2-го ранга",eD="Калькулятор поделен на несколько разделов. Каждый из них преследует свою цель, поэтому не всегда стоит ими пренебрегать.",sD="Академия технологий",tD="Волшебный лук T4",aD="Сохранено!",oD="Для удобства, есть три кнопки: MAX очки, MAX звезды и Сбросить",nD="T13 Лук",rD="До полосы:",lD="Сезон {season}",cD="T4 Посох",iD="В данном режиме расчет очков героев производится на основе отдельно введенных параметров героев, а так же распределения карт самовыбора.",uD="T2 Меч",dD="Вдохновление",gD="Сбросить пароль",mD="Дуэль — Алтарь призыва",AD="Казарма и таланты",pD="Начислено +{days} дней",hD="Регистрация",xD="Чертеж: легендарные доспехи T5",jD="Волшебная пыль T8",bD="Что будет, если подписка закончится?",yD="Чертеж: бессмертные доспехи T4",vD="4-100 место",wD="Калькулятор разбратывается без какой-либо целенаправленной поддержки, исключительно моими силами и исключительно по моему желанию.",fD="Редкая руна дракона",kD="Зелье удачи",_D="Данный раздел можно проигнорировать, если собираетесь использовать упрощенный режим расчета героев. В таком случае, в инвентаре нужно вручную заполнить количество карт героев для каждого ранга. Их же можно заполнить в калькуляторе героев",MD="Сохранение",TD="Сердце дракона Незамерзающего Холода T12",CD="Лук из темного железа T2",BD="Золотая эмблема дракона",SD="Введите имя героя...",ID="Лучницы",RD="{place} (сезон {season})",DD="Пользовательское соглашение (Оферта)",PD="Мощь огненных магов",ED="Если не увидели письмо в своем почтовом ящике, проверьте, пожалуйста, папку Спам. Иногда письмо попадает туда.",QD="Вы действительно хотите загрузить данные из игры в калькулятор?",qD="Калькулятор поможет подготовиться к событию, посмотреть и расчитать, на сколько сильные духи будут призваны при том или ином уровне. А так же позволит посмотреть, сколько очков на данном событии сможет заработать ваш альянс и каждый игрок в отдельности.",FD="Чертеж кузницы Победы T12",ND="До полоски{index}",GD="Кнопка {button} произведет полный сброс распределения карт самовыбора.",zD="Раздел с инвентарем содержит в себе все необходимые ресурсы, необходимые для событий Экстремальной мощи и Дуэль Альянса. В калькуляторах эти же ресурсы так же будут представлены, но только те, которые необходимы для расчетов в самом калькуляторе. В данном разделе можно сразу заполнить все ресурсы, которые у вас имеются. Либо это можно сделать по отдельности в каждом калькуляторе.",KD="T12 Посох",VD="Волшебная пыль T6",LD="Идеальное заклинание призыва",HD="Тыквенная Катапульта T7",WD="Внимание!",UD="T13 Посох",YD="Калькулятор снаряжения",OD="Продвинутое заклинание призыва",JD="Волшебная книга T7",ZD="Сердце",XD="T11 Лук",$D="Кровь титана",eP="Чертеж кузницы Вечный T11",sP="Точный расчёт очков — без догадок и лишних трат. Ваш еженедельный план - в Калькуляторе Kingdom Guard",tP="Ошибка при сохранении!",aP="Дуэль — Герой",oP="По навыкам",nP="Чертеж: доспехи дракона Ледяного Мороза T13",rP="T8 Меч",lP="Данный пресет покажет SSR-героев, которых вы можете получить в безумной рулетке, которые еще не прокачаны на 5 звезд. Они будут отсортированы в порядке количества карт до получения звезды",cP="Нет изменений",iP="Мощь: {power}",uP="<Text>Для наиболее эффективной прокачки, лучше не тратить книги талантов и короны на те стихии, которые не являются основными, так как это не даст эффективный прирост мощи.</Text> <Text>Однако, если это не так принципиально, а так же хочется набрать больше очков в ивентах, есть смысл потратить ресурсы и на остальные стихии.</Text> <Text>Ресурсы будут потрачены в порядке стихий, как они идут в казарме (или указаны в калькуляторе). Но в первую очередь ресурсы будут потрачены на приоритетную стихию.</Text>",dP="Потрачено:",gP="Для настройки героев и распредления карт самовыбора, пожалуйста, перейдите на страницу",mP="Сердце темного дракона T7",AP="Отличная руна дракона",pP="Ранг {rank}:",hP="Очков до открытия уровня {level}:",xP="Пароль",jP="Чертеж: доспехи Балрога T6",bP="Подключаем...",yP="Удалить профиль",vP="Книга опыта лучниц 1-го ранга",wP="T6 Посох",fP="Очки великой охоты",kP="Рога",_P="Волшебная пыль T5",MP="Потратить остатки книг казармы в артефакт",TP="Сердце дракона Kingstar T10",CP="Всего очков за <Purple>элитные</Purple> волны:",BP="Группа в телеграмм: {anchor}",SP="Легендарный чертеж кузницы T5",IP="В данном разделе вы можете настроить ключевые параметры под ваш сервер, если ваш сервер более ранний или более поздний, чем мой. Так же вы можете настроить количество очков, получаемых на событиях Дуэль Альянса и Экстремальная мощь.",RP="Чертеж: Позолоченные доспехи T8",DP="Бот для Telegram, позволяющий смотреть карту пещеры лавы. Работает внутри групп TG.",PP="Конвертирование ресурсов",EP="Конвертируем ресурсы замка?",QP="Идеальная руна дракона",qP="Добыча золота оффлайн",FP="Ваша текущая подписка действует до {until}",NP="На данной странице вы можете настроить автозагрузку ваших игровых данных в калькулятор.",GP="Синяя эмблема дракона",zP="Если письмо с активацией не пришло, убедитесь, что правильно указали почтовый ящик. В иных случаях, свяжитесь со мной напрямую: {email}",KP="Рога нефритового дракона T1",VP="Сердце демонического дракона T3",LP="Показать",HP="Забыли пароль",WP="Легендарный лук T5",UP="3 звезды",YP="Также, <a>тут</a> вы можете посмотреть детальную информацию по нужному вам уровню",OP="Распределение карт самовыбора",JP="Мои эмблемы дракона",ZP="Идеальный чертеж кузницы T3",XP="Настройки подписки",$P="Пернатый Страж T11",eE="Ведьма",sE="Волшебная пыль T9",tE="Чертеж кузницы T13",aE="Про калькулятор",oE="Некорректный email",nE="T2 Лук",rE="Напутствие",lE="Вы сохраните все свои данные. Расширенные расчёты станут недоступны до продления. Базовый ввод данных и синхронизация с игрой останутся бесплатными навсегда.",cE="Подписка",iE="Добавить новый профиль",uE="Рубин T13",dE="Прежде чем приступить к расчетам, прошу уделить несколько минут времени, и дочитать этот текст. Я хочу кратко рассказать про калькулятор и как им пользоваться.",gE="Настройки",mE="Потратить излишки светлых реагентов в артефакт",AE="T13 Меч",pE="<b>Доступ с любого устройства</b> — сайт удобно открывается и на телефоне, и на ПК. Не надо таскать за собой файл Excel",hE="Используя этот инструмент, вы действуете на свой страх и риск! Администрация данного сайта не несет ответственности за ваш игровой аккаунт и за ваших игровых персонажей!",xE="T10 Меч",jE="Достаточно очков для открытия нового уровня",bE="Не подключено",yE="Коэффициенты в Магазине БЛ",vE="Рубин T11",wE="Доспехи дракона",fE="Калькулятор доспехов дракона",kE="Редкий чертеж кузницы T1",_E="14-я элитная волна",ME="Сезоны",TE="Номер королевства, на котором вы играете. Например: 1150, 1570, 2020",CE="0 звезд",BE="Хвост",SE="1 место",IE="Чертеж: Ледяное Пламя доспехи T9",RE="Я <Link>соглашаюсь с Политикой обработки персональных данных</Link> и <LinkTerms>Пользовательским соглашением</LinkTerms>",DE="Есть аккаунт? Войти",PE="Будут загружены только необходимые игровые данные с вашего персонажа в калькулятор, а именно:",EE="Для дальнейшей работы на нашем сайте, вам необходимо принять эти политики.",QE="<b>Сохранение данных</b> — все ваши параметры сохраняются в профиле. Синхронизация с игрой в один клик (бесплатно даже без Подписки)",qE="Бронированная Акула T2",FE="4 звезды",NE="В некоторых случаях были замечены погрешности в мощи 19й волны. В игре мощь 19й волны может быть немного больше/меньше, нежели указано в калькуляторе.",GE="Чертеж: демонические доспехи T3",zE="T1 Посох",KE="- Это удобно.",VE="Необходимые ресурсы",LE="T3 Кинжал",HE="<Text>Внимание! Пользователь, а так же все данные, связанные с ним, будут окончательно удалены.</Text><b>Данное действие необратимо!</b>",WE="Политика обработки персональных данных",UE="Чешуя",YE="История",OE="Применить",JE="Если вы не согласны с данными политиками, или не хотите, чтобы мы продолжали обработку ваших персональных данных (только ваш Email), тогда вы можете удалить аккаунт в <Link>настройках профиля</Link>.",ZE="Мастер-партизан",XE="Руны дракона",$E="Сокращение трат ОД на монстров",eQ="{type} T{rank}",sQ="Лимит уровня зеленой руны",tQ="Установить новый пароль",aQ="Рубин T9",oQ="Снаряжение (четверг)",nQ="Новый пароль",rQ="Согласно оферте, услуга считается оказанной в полном объёме с момента активации Подписки на вашем аккаунте. Возврат после активации невозможен. Пожалуйста, внимательно ознакомьтесь с условиями до покупки.",lQ="Рога бессмертного дракона T4",cQ="Карты самовыбора",iQ="В случае, если данные на сайте отображаются не актуальными, попробуйте обновить страницу или перелогиниться на сайте.",uQ="Волшебная книга T5",dQ="Мастер сбора",gQ="Мои ресурсы и параметры",mQ="Потрачено ресурсов",AQ="Параметры злых духов",pQ="Использовано {icon}: {value}",hQ="Четвертый шаг: в шапке сайта выбрать ваш игровой профиль, чтобы смотреть данные и считать очки.",xQ="Вы действительно хотите удалить профиль {profileName}?",jQ="Посчитать",bQ="Настройки калькулятора",yQ="T9 Посох",vQ="Сила магии света",wQ="Параметры",fQ="У меня есть вопрос, куда обратиться?",kQ="<Text>Все ресурсы будут потрачены на прокачку артефакта, вместо прокачки дракона.</Text> <Text>Доступно только начиная с 28 уровня дракона.</Text> <Text>Стоит учесть, что если включены настройки учета замка, то сначала ресурсы будут потрачены на прокачку дракона, пока не дойдет до лимита по уровню замка. И только при достижении лимита, все оставшиеся ресурсы будут потрачены в артефакт.</Text> <Text>Если настройки учета замка не включены, все ресурсы будут потрачены на прокачку артефакта.</Text>",_Q="По количеству полос{index}",MQ="Бот пещеры лавы",TQ="Рога дракона Ледяное Пламя T9",CQ="Волшебная пыль T4",BQ="Мой замок сейчас",SQ="Голова",IQ="На почту {email} было отправлено письмо с инструкцией по восстановлению пароля.",RQ="Прочее",DQ="Повторите пароль",PQ="Фиолетовая эмблема дракона",EQ="Навыки",QQ="Первая помощь",qQ="Согласие на обработку персональных данных",FQ="Идеальное заклинание призыва (Переработано)",NQ="Безумная рулетка",GQ="Нет данных",zQ="Это безопасно?",KQ="Открыто осколков",VQ="Книга опыта лучниц 3-го ранга",LQ="Сортировать героев по звездам",HQ="Калькулятор дракона",WQ="Книг талантов за 1 книгу бойцов 3 ранга",UQ="Камень души дракона",YQ="<Text>Все оставшие книги казармы (в том числе книги самовыбора) будут потрачены в артефакт для набора очков СК/ЭМ</Text> <Text>Потратить книги казармы в артефакт возможно только тогда, когда все стихии будут прокачаны до 9 ранга.</Text> <Text>Стоит учесть, что сначала книги казармы будут обменены на книги талантов (если включена соответствующая настройка), а только потом остатки будут влиты в артефакт.</Text>",OQ="T6 Кинжал",JQ="Можно ли вернуть деньги?",ZQ="Внимание! Включен продвинутый режим подсчета очков героев",XQ="Книг талантов за 1 книгу бойцов 2 ранга",$Q="Всего карт:",e6="Смена пароля",s6="Награды в событии Дуэль Альянса",t6="Багровый Дракон T8",a6="Дуэль Альянса",o6="Привет! У нашего сайта обновились следующие политики:",n6="Редактирование профиля",r6="Грузоподъемность",l6="ИНН: <text>593306502526</text>",c6="T2 Посох",i6="Волшебная пыль T13",u6="Дуэль — Кузнец",d6="Можно прокачать уровней: {count}",g6="Замок, который я хочу",m6="Мощь волн",A6="10-я босс-волна",p6="Рога демонического дракона T3",h6="Безумная рулетка (ивент)",x6="Калькулятор Дуэли Альянса",j6="Используем коробки с рунами дракона?",b6="Чертеж: нефритовые доспехи T1",y6="По сезону{index}",v6="Книга опыта гоблинов 2-го ранга",w6="Требуется всего",f6="Kingdom ИНФО",k6="Дракон",_6="Скрывать героев с 5 звездами",M6="Доспехи Призрака T9",T6="Изменить снаряжение",C6="Отклонить",B6="Назад",S6="Выберите игровые профили для синхронизации с профилями калькулятора.",I6="По имени героя{index}",R6="Дракон + доспехи",D6="20-я босс-волна",P6="Роскошный длинный лук T7",E6="Книг талантов за 1 книгу бойцов 4 ранга",Q6="KG Companion - это игровой компаньон для поиска персонажей и просмотр их исторической мощи в игре Kingdom Guard",q6="Подписка на 30 дней - 990₽",F6="Первый шаг: авторизоваться в вашем игровом аккаунте",N6="100 ОД",G6="Учитывать будущую прокачку",z6="Очки экстремальной мощи",K6="Волшебная книга T14",V6="Мы используем cookie для сбора анонимной статистики, чтобы улучшать сайт. Подробнее в <Link>Политика использования файлов cookie и аналитических технологий</Link>.",L6="Калькуляторы Дуэль Альянса и Экстремальной мощи содержат в себе обобщенные результаты расчетов из всех остальных калькуляторов. Они нужны, чтобы посмотреть общее количество очков, которые вы можете заработать на данных событиях.",H6="Максимальный уровень зеленой руны:",W6="Нехватает {diff} очков для открытия нового уровня",U6="Успешно подключено",Y6="Принять",O6="Сердце дракона Ледняное Пламя T9",J6="Загружено",Z6="Колесо фортуны",X6="Таблица героев",$6="Необходимое количество очков",e5="По месту получения",s5="Продвинутый режим героев",t5="По звездам",a5="Ранг",o5="Алтарь призыва",n5="Карточки героев (суббота)",r5="Стремительный марш",l5="Фильтровать героев",c5="тыс.",i5="Злые духи",u5="Книг талантов за 1 книгу бойцов 1 ранга",d5='Если у вас много карт самовыбора, эта кнопка потратит их не все. Она распределит карты там, где нужно, для "максимальной выжимки", а оставшиеся карты вы можете распределить сами на своё усмотрение. Разницы в очках уже не будет.',g5="Общие",m5="млн.",A5="Огонь",p5="Книга опыта гоблинов 1-го ранга",h5="Волшебная пыль T3",x5="Боты",j5="По рангу",b5="<Text>На основе ваших ресурсов и параметров будет определен максимальный уровень замка, который можно прокачать.</Text> <Text>Далее, этот максимальный уровень замка будет использоваться как предел при прокачке дракона и расчета очков.</Text> <Text>При выключенной настройке будет учитываться текущий уровень замка, указанный в параметрах.</Text>",y5="Волшебная пыль T10",v5="<Text>Менять книги на таланты возможно только тогда, когда стихия достигла максимального ранга.</Text> <Text>Если, к примеру, стихия огня прокачана до максимума, менять можно только книги огня на книги талантов.</Text>",w5="Фильтры",f5="Новый профиль",k5="T9 Лук",_5="Калькулятор алтаря призыва",M5="Аккаунт был успешно зарегистрирован!",T5="Рубин T1",C5="T11 Меч",B5="Большие иконки",S5="Дуэль — Повышение бойцов",I5="Книга опыта гоблинов 4-го ранга",R5="R ранг",D5="Последний открытый ранг камней ведьмы",P5="Герои",E5="Карточки героев",Q5="Данный инструмент загрузки данных в калькулятор не является официальным, и в теории может привести к временной/постоянной блокировке вашего персонажа и/или аккаунта!",q5="Восстановленных бойцов",F5="Я согласен с <link>офертой</link> и <linkPrivacy>Политикой обработки персональных данных</linkPrivacy>",N5="Причина создания",G5="Активация пользователя",z5="Зеленая эмблема дракона",K5="Дуэль — Снаряжение героя",V5="Лук Грома T9",L5="Академия",H5="Сердце дракона Балрога T6",W5="T5 Лук",U5="T9 Меч",Y5="Волшебная пыль T1",O5='<Text>Книги самовыбора будут обменяны на книги выбранной стихии, которую хочется прокачивать в первом приоритете.</Text> <Text>Если стихия прокачана максимально, и не включен параметр "Менять книги-излишки на таланты", книги самовыбора использоваться не будут.</Text>',J5="<Text>Все излишки кузнечных молотов будут потрачены в артефакт.</Text> <Text>Доступно только начиная с 2000 уровня кузницы.</Text>",Z5="Сезон {season} >>",X5="T11 Кинжал",$5="Потратить излишки кузнечных молотов в артефакт",e7="Таверна (обычная вербовка)",s7="11-50 место",t7="Калькулятор",a7="Нехватает",o7="Данный раздел поможет настроить сам калькулятор под вас. Дело в том, что все сервера в игре находятся на разных стадиях развития. Из-за этого, у одних могут уже быть открыты более поздние ранги и герои, в то время как у более новых серверов открыто еще очень мало. Стандартные же настройки калькулятора заточены под сетку серверов 1491-1577, по той причине, что сам разработчик играет в этой сетке серверов.",n7="T1 Меч",r7="Лук T13",l7="В целом потрачено",c7="Когти",i7="Пользователь был успешно активирован. Теперь вы можете войти на сайт, используя логин и пароль",u7="Сбросить",d7="Скорость сбора золота",g7="Награды за трон БЛ",m7="Третий шаг: загрузить данные из игры для нужного вам персонажа (профиля)",A7="Легендарные рога дракона T5",p7="Королевский лук T8",h7="4-10 место",x7="T8 Лук",j7="Уровень галереи",b7="Рубин T12",y7="Снаряжение",v7="Книга опыта огненных магов 3-го ранга",w7="Подписка в Kingdom Guard Calculator",f7='Считать таланты и короны "1 через 8"',k7="Данный калькулятор не относится к основным, он нужен для отдельного события - Вторжение злых духов.",_7="T3 Посох",M7="Длина пароля должна быть 8 символов или больше",T7="Частые вопросы (FAQ)",C7="Корона оракула",B7="Кровь титана (Переработано)",S7="Подписка не активна!",I7="Сезон",R7="Где можно получить",D7="Меняем книги казармы самовыбора в приоритетную стихию?",P7="Создать профиль",E7="Если вы абсолютно уверены, что хотите удалить пользователя, то введите в поле ниже <Text>CONFIRM</Text>",Q7="Войти",q7="Мастер стрельбы",F7="Карты ге